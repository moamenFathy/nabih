# ==========================================
# Git Ignore Rules for Project Nabih
# ==========================================

# 1. Virtual Environments (Never push venv to git!)
.venv/
venv/
ENV/
env/

# 2. Secrets & Environment Variables
.env
.env.local
*.env
!.env.example

# 3. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.mypy_cache/

# 4. Diagnostic & Application Logs
logs/*.log
*.log
!logs/.gitkeep

# 5. Temporary Audio Files (if any)
*.wav
*.mp3
*.ogg

# 6. Operating System Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# 7. IDE & Editor Specifics
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
