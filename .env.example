# =======================================================
# Project Nabih - Environment Variables Example Template
# Copy this file to .env and fill in your actual credentials
# =======================================================

# -------------------------------------------------------
# 1. Speech-to-Text (STT) - Groq Whisper API (Free Tier)
# Get your free key at: https://console.groq.com/keys
# -------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=whisper-large-v3

# -------------------------------------------------------
# 2. LLM Brain - Hosted Qwen 27B-FP8
# The base URL of your hosted OpenAI-compatible inference server
# (e.g., http://localhost:8000/v1 or https://your-server-domain/v1)
# -------------------------------------------------------
QWEN_BASE_URL=http://localhost:8000/v1
QWEN_API_KEY=EMPTY
QWEN_MODEL_NAME=Qwen3.8-27B-FP8
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1024

# -------------------------------------------------------
# 3. Text-to-Speech (TTS) - Microsoft Edge Neural Voices
# Egyptian Arabic voices: ar-EG-SalmaNeural (Female), ar-EG-ShakirNeural (Male)
# -------------------------------------------------------
TTS_VOICE=ar-EG-SalmaNeural
TTS_RATE=+0%
TTS_PITCH=+0Hz

# -------------------------------------------------------
# 4. Trigger & Audio Capture Settings
# Push-to-Talk hotkey: caps_lock, ctrl+space, or custom key
# -------------------------------------------------------
HOTKEY=caps_lock
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1

# -------------------------------------------------------
# 5. The Witcher Diagnostic Logging Settings
# -------------------------------------------------------
LOG_LEVEL=DEBUG
LOG_TO_FILE=True
LOG_FILE_PATH=logs/shuri_diagnostics.log

# -------------------------------------------------------
# 6. Workspace & Project Context
# Root directory where your active code projects reside
# -------------------------------------------------------
WORKSPACE_ROOT=C:/Users/moame
